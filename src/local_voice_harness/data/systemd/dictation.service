[Unit]
Description=Voice harness faster-whisper dictation daemon
After=graphical-session.target

[Service]
Type=simple
Environment=DICTATION_MODEL=large-v3-turbo
EnvironmentFile=-%h/.config/dictation/backend.env
WorkingDirectory=%h/local-voice-harness
ExecStart=%h/local-voice-harness/.venv-dictation/bin/voice-harness-dictation
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
